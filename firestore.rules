rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the requesting user authenticated and owns this userId?
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // ─── USER ROOT DOCUMENT ────────────────────────────────────────────────
    // Allow users to read/write their own top-level user document (if used)
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // ─── CORE DATA COLLECTIONS ──────────────────────────────────────────
      // All main data subcollections live under users/{userId}/{collection}
      // Only the authenticated owner can read, create, update, or delete.
      match /properties/{docId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /tenants/{docId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /agreements/{docId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /rentRecords/{docId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /taxRecords/{docId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /utilityRecords/{docId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /insuranceRecords/{docId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /maintenanceRecords/{docId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /vendors/{docId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /managementFees/{docId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /payouts/{docId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /deposits/{docId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // ─── SETTINGS ────────────────────────────────────────────────────────
      // Single document at users/{userId}/settings/default
      match /settings/{docId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // ─── ALERTS ──────────────────────────────────────────────────────────
      // Lease expiry alerts generated by ClientAutomation and managed
      // by useNotifications (mark-read, clear, etc.)
      match /alerts/{alertId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // ─── PROFILE ─────────────────────────────────────────────────────────
      // Stores FCM push token (profile/notifications) and
      // daily automation run log (profile/automation_log)
      match /profile/{docId} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }

    // ─── CATCH-ALL: deny everything else ────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
